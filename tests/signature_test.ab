// tests/fixtures/signed-sample.pdf was signed by tools/sign-file.ab with a key made
// on the spot and thrown away, under a self-signed certificate: not a qualified
// signature. tools/test-signatures.sh runs the signing side with independent
// verifiers. Here: our verifier on that file, damaged and whole.

import "abla/test"
import "abla/fs"
import "abla/bytes"
import "abla/crypto"
import "abla/process"
import "../src/pdf.ab"

// No private key belongs in this repository: one made by openssl when the test runs signs
// below, and a stub proves the failure paths.
class NoCertificates : PdfSigner {
    fun certificates(): array<string> = array<string>()
    fun algorithmOid(): string = PDF_OID_RSA_SHA256
    fun sign(message: string): string = "x"
}

fun signingWithAKey(): void {
    val dir = "build/signature-test"
    command("mkdir").argument("-p").argument(dir).run()
    val keyPem = dir + "/key.pem"
    val certPem = dir + "/cert.pem"
    val smallPem = dir + "/small.pem"
    val made = command("openssl").argument("genrsa").argument("-out").argument(keyPem).argument("2048").run()
    if (!expect(made == 0, "openssl made a key")) return
    command("openssl").argument("req").argument("-x509").argument("-new").argument("-key").argument(keyPem)
        .argument("-subj").argument("/CN=abla-pdf TEST ONLY").argument("-days").argument("2").argument("-sha256").argument("-out").argument(certPem).run()
    command("openssl").argument("genrsa").argument("-out").argument(smallPem).argument("1024").run()
    val key = pdfParseRsaPrivateKey(pdfPemToDer(path(keyPem).readText()))
    expect(key.ok, "a 2048-bit key is read: ${key.error}")
    val small = pdfParseRsaPrivateKey(pdfPemToDer(path(smallPem).readText()))
    expect(!small.ok && small.error.contains("1024"), "a 1024-bit key is refused")

    val doc = PdfDocument()
    doc.addPage(PdfPage())
    val signer = PdfRsaSigner(key.der, [pdfPemToDer(path(certPem).readText())])
    val signed = pdfSign(doc.toBytes(), signer, PdfSignOptions(1767225600000))
    expect(signed.ok, "signed: ${signed.error}")
    val checks = pdfVerifySignatures(signed.bytes)
    expectEqual(checks.size, 1, "one signature made")
    if (checks.size == 1) expect(checks[0].signatureValid && checks[0].digestValid && checks[0].coversWholeFile, "our signature verifies: ${checks[0].problem}")
    // PKCS#1 v1.5 has no randomness, whatever the blinding does inside.
    val again = pdfSign(doc.toBytes(), signer, PdfSignOptions(1767225600000))
    expectEqual(again.bytes, signed.bytes, "the same bytes each time")

    val noKey = pdfSign(doc.toBytes(), PdfRsaSigner("junk", signer.certificates()), PdfSignOptions(0))
    expect(!noKey.ok, "a signer with a bad key fails")
    command("rm").argument("-rf").argument(dir).run()
    return
}

fun main: int {
    signingWithAKey()
    val file = path("tests/fixtures/signed-sample.pdf").readText()
    val checks = pdfVerifySignatures(file)
    expectEqual(checks.size, 1, "one signature")
    val found = checks[0]
    expect(found.problem == "", "no problem: ${found.problem}")
    expect(found.digestValid, "digest")
    expect(found.signatureValid, "signature")
    expect(found.coversWholeFile, "whole file")
    expectEqual(found.fieldName, "Signature1", "field")
    expectEqual(found.subFilter, "ETSI.CAdES.detached", "type")
    expect(found.certificate.commonName.contains("TEST ONLY"), "certificate name")
    expectEqual(found.reason, "Teste de integração", "reason")
    expectEqual(pdfParseDate(found.signedAt) ?? -1, 1767225600000, "time")

    // Any change to signed bytes fails, wherever it is.
    val at = file.indexOf("/ByteRange")
    for (position in [20, 500, 3000, at - 50, file.size - 30]) {
        val b = byteBuffer()
        b.appendByteValue((file[position] + 1) & 255)
        val changed = file.slice(0, position) + b.toText() + file.slice(position + 1, file.size)
        val r = pdfVerifySignatures(changed)
        var bad = true
        for (one in r) if (one.digestValid && one.signatureValid) bad = false
        expect(bad, "change at $position detected")
    }
    // A later update isn't covered, and says so; the signature itself stays valid.
    val appended = pdfVerifySignatures(file + "% appended\n")
    expectEqual(appended.size, 1, "still one")
    expect(appended[0].signatureValid && !appended[0].coversWholeFile, "appended bytes reported")

    // Damage in the CMS or the structure never panics.
    var seed = 12345
    for (i in 0 until 400) {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff
        val position = seed % file.size
        val b = byteBuffer()
        b.appendByteValue(seed & 255)
        pdfVerifySignatures(file.slice(0, position) + b.toText() + file.slice(position + 1, file.size))
    }
    expect(!pdfParseCertificate("junk").ok, "bad certificate")
    expect(!pdfParseRsaPrivateKey("junk").ok, "bad key")
    expectEqual(pdfPemToDer("no pem here"), "", "bad pem")

    val doc = PdfDocument()
    doc.addPage(PdfPage())
    val failed = pdfSign(doc.toBytes(), NoCertificates(), PdfSignOptions(0))
    expect(!failed.ok && failed.error != "", "signer without certificates fails")
    expect(!pdfSign("junk", NoCertificates(), PdfSignOptions(0)).ok, "junk input fails")
    testsPassed()
}
