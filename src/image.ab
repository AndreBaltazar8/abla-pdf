// Decoding image files into what a PDF image XObject holds. JPEG data passes
// through unchanged; PNG is decoded to 8-bit samples with alpha split off.

import "util.ab"
import "inflate.ab"
import "abla/bytes"

class PdfDecodedImage(
    val ok: bool,
    val error: string,
    val width: int,
    val height: int,
    // 1 gray, 3 RGB, 4 CMYK.
    val components: int,
    val samples: string,
    val alpha: string,
    val isJpeg: bool,
    val invertedCmyk: bool
)

private val MAX_PIXELS = 100000000

private fun failed(reason: string): PdfDecodedImage =
    PdfDecodedImage(false, reason, 0, 0, 0, "", "", false, false)

// Reads the dimensions and colour channels of a JPEG file, without decoding it.
fun pdfReadJpeg(data: string): PdfDecodedImage {
    if (data.size < 4 || data[0] != 0xff || data[1] != 0xd8) return failed("not a JPEG file")
    var at = 2
    var adobe = false
    while (at + 4 <= data.size) {
        if (data[at] != 0xff) return failed("malformed JPEG marker")
        val marker = data[at + 1]
        if (marker == 0xff) at = at + 1
        else if (marker == 0xd9 || marker == 0xda) return failed("JPEG has no frame header")
        else if (marker >= 0xd0 && marker <= 0xd7 || marker == 0x01) at = at + 2
        else {
            val length = pdfU16(data, at + 2)
            if (length < 2) return failed("malformed JPEG segment")
            if (marker == 0xee && length >= 7 && pdfStartsWithAt(data, at + 4, "Adobe")) adobe = true
            val frame = marker >= 0xc0 && marker <= 0xcf && marker != 0xc4 && marker != 0xc8 && marker != 0xcc
            if (frame) {
                if (at + 10 > data.size) return failed("truncated JPEG frame header")
                val height = pdfU16(data, at + 5)
                val width = pdfU16(data, at + 7)
                val components = data[at + 9]
                if (data[at + 4] != 8) return failed("only 8-bit JPEG is supported")
                if (width == 0 || height == 0) return failed("JPEG without a size")
                if (components != 1 && components != 3 && components != 4) return failed("unsupported JPEG channels")
                return PdfDecodedImage(true, "", width, height, components, data, "", true, components == 4 && adobe)
            }
            at = at + 2 + length
        }
    }
    failed("JPEG has no frame header")
}

private fun paeth(a: int, b: int, c: int): int {
    val p = a + b - c
    val pa = if (p > a) p - a else a - p
    val pb = if (p > b) p - b else b - p
    val pc = if (p > c) p - c else c - p
    if (pa <= pb && pa <= pc) a else if (pb <= pc) b else c
}

private class PngPass(val xStart: int, val yStart: int, val xStep: int, val yStep: int)

// Decodes a PNG file: all colour types and depths, interlaced or not, reduced to
// 8-bit gray or RGB samples plus an 8-bit alpha plane when the file has one.
fun pdfDecodePng(data: string): PdfDecodedImage {
    if (!pdfStartsWithAt(data, 0, "\x89PNG\r\n\x1a\n")) return failed("not a PNG file")
    if (data.size < 33 || !pdfStartsWithAt(data, 12, "IHDR")) return failed("PNG has no header")
    val width = pdfU32(data, 16)
    val height = pdfU32(data, 20)
    val depth = data[24]
    val colorType = data[25]
    val interlace = data[28]
    if (width <= 0 || height <= 0 || width > 65535 || height > 65535 || width * height > MAX_PIXELS) {
        return failed("unsupported PNG size")
    }
    if (data[26] != 0 || data[27] != 0 || interlace > 1) return failed("unsupported PNG method")
    val channels = when (colorType) {
        0, 3 -> 1
        2 -> 3
        4 -> 2
        6 -> 4
        else -> 0
    }
    if (channels == 0) return failed("invalid PNG colour type")
    if (depth != 1 && depth != 2 && depth != 4 && depth != 8 && depth != 16) return failed("invalid PNG bit depth")
    val idat = byteBuffer()
    var palette = ""
    var transparency = ""
    var at = 8
    var running = true
    while (running && at + 12 <= data.size) {
        val length = pdfU32(data, at)
        val kind = pdfClampedSlice(data, at + 4, at + 8)
        if (at + 12 + length > data.size) running = false
        else {
            val body = data.slice(at + 8, at + 8 + length)
            when (kind) {
                "IDAT" -> idat.appendText(body)
                "PLTE" -> palette = body
                "tRNS" -> transparency = body
                "IEND" -> running = false
                else -> {}
            }
            at = at + 12 + length
        }
    }
    if (colorType == 3 && palette.size < 3) return failed("PNG palette missing")
    val bitsPerPixel = channels * depth
    val bytesPerPixel = if (bitsPerPixel < 8) 1 else bitsPerPixel / 8
    // Room for every row of every pass, with one filter byte each.
    val limit = ((width * bitsPerPixel + 7) / 8 + 1) * height * 2 + 1024
    val inflated = pdfZlibDecompress(idat.toText(), limit)
    val raw = inflated.data
    val outChannels = if (colorType == 2 || colorType == 3 || colorType == 6) 3 else 1
    val hasAlpha = colorType == 4 || colorType == 6 || transparency.size > 0
    val rgb = filledArray(width * height * outChannels, 0)
    val alpha = filledArray(if (hasAlpha) width * height else 0, 255)
    val passes = if (interlace == 1) [
        PngPass(0, 0, 8, 8), PngPass(4, 0, 8, 8), PngPass(0, 4, 4, 8), PngPass(2, 0, 4, 4),
        PngPass(0, 2, 2, 4), PngPass(1, 0, 2, 2), PngPass(0, 1, 1, 2)
    ] else [PngPass(0, 0, 1, 1)]
    var pos = 0
    val maxSample = (1 << depth) - 1
    for (pass in passes) {
        val passWidth = (width - pass.xStart + pass.xStep - 1) / pass.xStep
        val passHeight = (height - pass.yStart + pass.yStep - 1) / pass.yStep
        if (passWidth > 0 && passHeight > 0) {
            val rowBytes = (passWidth * bitsPerPixel + 7) / 8
            var previous = filledArray(rowBytes, 0)
            for (row in 0 until passHeight) {
                if (pos + 1 + rowBytes > raw.size) return failed("PNG image data too short")
                val filter = raw[pos]
                pos = pos + 1
                val line = filledArray(rowBytes, 0)
                for (i in 0 until rowBytes) {
                    val x = raw[pos + i]
                    val a = if (i >= bytesPerPixel) line[i - bytesPerPixel] else 0
                    val b = previous[i]
                    val c = if (i >= bytesPerPixel) previous[i - bytesPerPixel] else 0
                    line[i] = when (filter) {
                        0 -> x
                        1 -> (x + a) & 255
                        2 -> (x + b) & 255
                        3 -> (x + (a + b) / 2) & 255
                        4 -> (x + paeth(a, b, c)) & 255
                        else -> x
                    }
                }
                pos = pos + rowBytes
                val y = pass.yStart + row * pass.yStep
                for (column in 0 until passWidth) {
                    val px = pass.xStart + column * pass.xStep
                    val target = y * width + px
                    // The first channel at any depth, then the rest at 8 or 16 bits.
                    var v0 = 0
                    if (depth >= 8) v0 = line[column * bytesPerPixel]
                    else {
                        val bit = column * depth
                        v0 = (line[bit >> 3] >> (8 - depth - (bit & 7))) & maxSample
                    }
                    val step = depth / 8
                    if (colorType == 3) {
                        val entry = v0 * 3
                        if (entry + 3 > palette.size) return failed("PNG palette index out of range")
                        rgb[target * 3] = palette[entry]
                        rgb[target * 3 + 1] = palette[entry + 1]
                        rgb[target * 3 + 2] = palette[entry + 2]
                        if (hasAlpha) alpha[target] = if (v0 < transparency.size) transparency[v0] else 255
                    } else if (colorType == 0 || colorType == 4) {
                        val gray = if (depth >= 8) v0 else v0 * 255 / maxSample
                        rgb[target] = gray
                        if (colorType == 4) alpha[target] = line[column * bytesPerPixel + step]
                        else if (hasAlpha && transparency.size >= 2) {
                            val raw16 = if (depth == 16) (v0 << 8) | line[column * 2 + 1] else v0
                            alpha[target] = if (raw16 == pdfU16(transparency, 0)) 0 else 255
                        }
                    } else {
                        val base = column * bytesPerPixel
                        rgb[target * 3] = line[base]
                        rgb[target * 3 + 1] = line[base + step]
                        rgb[target * 3 + 2] = line[base + 2 * step]
                        if (colorType == 6) alpha[target] = line[base + 3 * step]
                        else if (hasAlpha && transparency.size >= 6) {
                            val same = if (depth == 16) {
                                ((line[base] << 8) | line[base + 1]) == pdfU16(transparency, 0) &&
                                    ((line[base + 2] << 8) | line[base + 3]) == pdfU16(transparency, 2) &&
                                    ((line[base + 4] << 8) | line[base + 5]) == pdfU16(transparency, 4)
                            } else {
                                line[base] == pdfU16(transparency, 0) && line[base + 1] == pdfU16(transparency, 2) &&
                                    line[base + 2] == pdfU16(transparency, 4)
                            }
                            alpha[target] = if (same) 0 else 255
                        }
                    }
                }
                previous = line
            }
        }
    }
    val sampleText = pdfIntsToBytes(rgb)
    val alphaText = if (hasAlpha) pdfIntsToBytes(alpha) else ""
    PdfDecodedImage(true, "", width, height, outChannels, sampleText, alphaText, false, false)
}

fun pdfIntsToBytes(values: array<int>): string {
    val out = byteBuffer()
    for (v in values) out.appendByteValue(v)
    out.toText()
}
